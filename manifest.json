{
  "name": "CyberTrace",
  "version": "1.0.0",
  "description": "AI-assisted digital forensics Chrome extension for PDF analysis",
  "manifest_version": 3,
  "icons": {
    "16": "public/icon-16.png",
    "48": "public/icon-48.png",
    "128": "public/icon-128.png"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "downloads",
    "scripting",
    "webNavigation",
    "activeTab"
  ],
  "action": {
    "default_title": "Open CyberTrace Analysis"
  },
  "host_permissions": [
    "<all_urls>",
    "file:///*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' http: https: file:"
  },
  "minimum_chrome_version": "116"
}
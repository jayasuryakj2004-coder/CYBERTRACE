# CyberTrace Backend Configuration
# Copy to .env and fill in your values

# Gemini API key stays on the backend (get from https://aistudio.google.com/apikey).
GEMINI_API_KEY=your-gemini-api-key

# Configurable model; this default is the current low-latency Flash model.
GEMINI_MODEL=gemini-3.8-flash

PORT=3001
HOST=127.0.0.1
CYBERTRACE_API_TOKEN=replace-with-a-random-token-at-least-32-characters-long

# For remote deployment, use exact origins, comma-separated. Never use *.
CORS_ORIGINS=